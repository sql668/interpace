# 后端环境变量模板（T10.3）。
#
# 用法：复制成 `.env.<APP_ENV>`（如 `.env.development`、`.env.demo`）后填入真实值。
# 配置加载顺序见 app/core/settings.py 的 _load_layered_env：
#   .env.<APP_ENV> 文件的键值 → 操作系统环境变量（后者覆盖前者）。
#   注意：**不会**读取基础的 `.env`，实际生效的只有与 APP_ENV 对应的那个文件。
#
# 注意：真实密钥不要提交进仓库；.env* 已在 .gitignore 里。

# 运行环境：development / demo / test / production（也接受 dev / prod / staging 简写）。
# 决定加载哪个 .env.<APP_ENV> 文件；**写错会启动失败**，不会静默退回开发环境。
APP_ENV=development

# 是否信任 X-Real-IP / X-Forwarded-For 来判断客户端 IP。
# 部署在 Nginx 反向代理后面时设为 true（否则配额会把所有访客算成同一个 IP）；
# 直连暴露的服务保持 false——打开等于让调用方自己决定"我是谁"，配额形同虚设。
TRUST_PROXY_HEADERS=false

# 跨域白名单，逗号分隔，例如：https://你的域名.com
# 生产环境是**同源部署**（Nginx 同时托管前端与反代 /api），浏览器不会发跨域请求，
# 所以这一项留空即可；只有前后端放在不同域名下才需要配。
# 不配时默认只允许本机开发地址（localhost / 127.0.0.1 的 5173、8080）。
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 必填项：缺失或不合格时**应用启动就会失败**（不是运行期才报错）
# ---------------------------------------------------------------------------

# MySQL 连接串（SQLAlchemy 风格）。必填。
MYSQL_URL=mysql+pymysql://root:password@127.0.0.1:3306/inter-pace?charset=utf8mb4

# JWT 签名密钥。必填，且**至少 32 字节**（RFC 7518 对 HS256 的建议）。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：换密钥会让所有已签发的 token 失效，需在低峰期操作并提前通知。
JWT_SECRET=

# MinIO 对象存储四元组。必填。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-resources
MINIO_SECURE=false

# ---------------------------------------------------------------------------
# 选填：都有默认值，不配也能启动
# ---------------------------------------------------------------------------

# JWT 算法与有效期（分钟）
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_MINUTES=10080

# 大模型（兼容 OpenAI 接口）。Key 为空也能启动，但调用模型时会失败。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=1024

# Redis（提示词模板缓存）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 火山引擎语音服务（模拟面试的 ASR / TTS）。
# Key 为空也能启动，但语音面试会报「未配置 VOLC_API_KEY」。
VOLC_API_KEY=
# ASR 模型版本：2.0 小时版 volc.seedasr.sauc.duration / 并发版 volc.seedasr.sauc.concurrent
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# TTS 模型版本：seed-tts-2.0（合成大模型2.0）/ seed-icl-2.0（声音复刻2.0）
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 音色 ID：从控制台 > 音色库复制。必须与上面的 TTS 模型版本配套，
# 否则会报 "resource ID is mismatched with speaker related resource"（实测踩过）。
VOLC_TTS_SPEAKER=

# 语音服务接入点。一般不用改；本地联调时可以指向假服务。
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_FILE_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
VOLC_TTS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection

# ---------------------------------------------------------------------------
# 演示环境配额（T12.4）：**不在这个文件里配**，见 config/demo_limits.json
# ---------------------------------------------------------------------------
# 配额项（每 IP 的 token 总量 / 每日轮数 / 出题 / 复盘 / 语音分钟、每用户上限、
# 全局日预算、降本开关）统一放在 `config/demo_limits.json`，改完保存即生效（最多 5 秒），
# 不需要重启服务。为什么不用 .env：配额项多且需要分组，混在这里会把真正的
# 环境配置淹没（详见 config/README.md）。
