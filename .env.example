# docker compose 用的环境变量模板（T11.6）
#
# 用法：cp .env.example .env，填好真实值再 `docker compose up -d`。
#
# **为什么必须叫 `.env`**：docker compose 只会自动读取当前目录下的 `.env`
# （别的名字都得每次加 `--env-file`，很容易忘），所以这里跟着它的约定走。
# 注意：这是**仓库根目录**的 .env，和后端的 `interpace-backend/.env.development`
# 是两个不同的文件，别搞混——那个是本地开发用的，这个是给容器用的。
#
# `.env` 已被 .gitignore 排除（`.env.*` 规则），**不要**把真实密钥提交上去。
#
# 这里放"整站级别"的变量；后端自己读的那些（模型 Key、语音 Key 等）也写在这一个文件里，
# compose 会用 env_file 整份注入 backend 容器。

# ---------- 运行环境 ----------
# development / demo / test / production（也接受 dev / prod / staging 简写）。
# 写错会启动失败，不会静默退回开发环境。
#
# demo 与 production 的关键差别：
#   demo       → 启用 config/demo_limits.json 里的配额与降本开关（按 IP 限 token、单场面试 3 分钟、关语音等）
#   production → 不受演示配额约束
APP_ENV=production

# 镜像标签：自己构建时用同一个 tag 打前后端两个镜像，回滚就是换这个值（见 docs/部署）。
IMAGE_TAG=local

# 镜像仓库前缀（可选）。填了之后上面两个应用镜像就会带上仓库地址，
# 服务器可以直接 `docker compose pull` —— 适合"CI 构建 + 镜像仓库"的部署方式；
# 在服务器上本地构建时留空即可。
# 例：IMAGE_PREFIX=registry.cn-shenzhen.aliyuncs.com/你的命名空间/
# IMAGE_PREFIX=

# Nginx 对外端口。默认 80；本机验证时用 8080 避开系统占用。
WEB_PORT=80

# ---------- （可选）接在已有的 Nginx Proxy Manager 后面 ----------
# 服务器上如果已经跑着 NPM（它占着 80/443），就走叠加文件：
#   docker compose -f docker-compose.yml -f docker-compose.npm.yml up -d
# 这两行是那时的配置；不用 NPM 的话保持注释即可。
#
# NPM 所在的 docker 网络名，查看方式：
#   docker inspect <npm容器名> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
# NPM_NETWORK=
#
# 用 NPM 时把对外端口收到回环上（NPM 走容器网络找我们，不需要这个端口对外）
# WEB_PORT=127.0.0.1:8088

# ---------- MySQL ----------
# 注意：密码里若含 @ : / 等字符，compose 拼 MYSQL_URL 时会用到**未编码**的原值，
# 所以请用「字母 + 数字 + 下划线」这类字符，避免连接串解析出错。
MYSQL_ROOT_PASSWORD=请改成足够长的随机密码
MYSQL_DATABASE=inter-pace
# 2核2G 上建议 128M~256M；机器更大可以调高
MYSQL_BUFFER_POOL=256M

# ---------- Redis ----------
REDIS_MAXMEMORY=96mb

# ---------- MinIO ----------
# 镜像源：MinIO 的官方镜像地址换过好几次，用哪个取决于你能拉到哪个。
# 先用 `docker image ls | grep minio` 看服务器上有没有现成的，有就直接写它的标签；
# 没有的话：`minio/minio:latest`（Docker Hub）或 `quay.io/minio/minio:latest`（需先 docker login quay.io）。
# MINIO_IMAGE=minio/minio:latest

# 改成随机值，并在控制台/客户端里用它创建桶（后端启动时会自动建桶）。
MINIO_ROOT_USER=请改成自定义的用户名
MINIO_ROOT_PASSWORD=请改成足够长的随机密码

# ---------- 鉴权 ----------
# 必填，且**至少 32 字节**（启动期会校验）。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 换密钥会让所有已签发的 token 失效，需在低峰期操作并提前通知。
JWT_SECRET=

# ---------- 大模型 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=10240

# ---------- 火山引擎语音（模拟面试的 ASR / TTS）----------
# 演示环境若在 config/demo_limits.json 里关掉了语音面试，这几个可以不填。
VOLC_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 音色 ID 必须与 TTS 模型版本配套，否则会报 "resource ID is mismatched with speaker related resource"
VOLC_TTS_SPEAKER=

# ---------- 其它 ----------
# 生产环境不需要改这两项，留着是为了本地验证方便
# RUN_MIGRATIONS=true
# TRUST_PROXY_HEADERS=true

# 前后端分域部署时才需要（同源部署用不到，见 interpace-backend/.env.example 的说明）
# CORS_ORIGINS=https://你的域名.com
