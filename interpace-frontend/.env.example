# 环境变量模板：本地需要覆盖时复制为 .env.local（已被 git 忽略），不要在 .env 文件里放密钥。
# 只有 VITE_ 前缀的变量会注入前端代码，并会被打包进产物，禁止写入 Token。

# 站点标题，用于浏览器标签页等展示
VITE_APP_TITLE=面途 InterPace

# 前端请求接口的基础地址；相对路径表示同源，开发环境由 Vite 代理转发到后端
VITE_API_BASE_URL=/api/v1

# 开发服务器代理的后端地址，只在 vite.config.ts 里读取，不会进入前端产物
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
